# Copy this file to .env and fill values locally.
# Never commit real credentials.

MAX_BOT_TOKEN=
# Hackathon contour of the MAX API (production would be https://platform-api.max.ru)
MAX_API_BASE_URL=https://platform-api2.max.ru
# Public Russian Trusted CA certificate file (see certs/README.md).
# It is trusted by the app process only; never disable TLS verification.
MAX_CA_CERT_PATH=
# SHA-256 fingerprint of that certificate, verified from an official source (K-05a).
MAX_CA_CERT_SHA256=
DATABASE_URL=

# K-30b: the worker process receives MAX webhook events only when this is true
# (server only; local Compose keeps it false). The secret is the one given to
# POST /subscriptions; MAX sends it in the X-Max-Bot-Api-Secret header.
MAX_EVENTS_ENABLED=
MAX_WEBHOOK_SECRET=
# Optional comma-separated bot features (README, "Дополнительные функции бота"):
#   examples  — model companies (K-28) on the INN step;
#   whatif    — "Что будет, если…" scenario delta, real profile is not changed;
#   deadlines — "Что и когда" grouped by due date from the 4-01 action queue;
#   explain   — "Простым языком" retelling via LLM_PROVIDER (template works without keys);
#   cards     — "Открыть карточку" button under the demo notification; enable only when the site root serves the mini app.
# Empty means all optional features are disabled. Server check set: examples,whatif,deadlines,explain
BOT_FEATURES=
# Port of the bot HTTP server inside the worker container (default 3001) and
# the loopback host port nginx proxies /webhook to (default 3002).
BOT_HTTP_PORT=
# Listen address of that HTTP server (default 0.0.0.0).
BOT_HTTP_HOST=
BOT_WEBHOOK_HOST_PORT=

# Docker Compose (local defaults are used when empty; see README → Docker Compose)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
MINIAPP_API_PORT=
MINIAPP_PORT=
# Optional runtime image for `docker compose --profile local-model up`
LOCAL_LLM_IMAGE=

# AI provider: template (default, no AI) | gigachat | local
# The bot "explain" feature uses GigaChat only when LLM_PROVIDER=gigachat and
# GIGACHAT_AUTH_KEY is set; otherwise it answers with the no-AI template.
LLM_PROVIDER=template
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Optional GigaChat overrides (defaults in packages/classifier/src/gigachat/README.md)
GIGACHAT_AUTH_URL=
GIGACHAT_API_BASE_URL=
GIGACHAT_MODEL=
LOCAL_LLM_URL=

# Rulepack registry for `pack add` (default: data/rulepacks/installed)
RULEPACK_DIRECTORY=

# 5-07 backups on the VPS (/etc/max-hackathon/backup.env; defaults when empty,
# see docs/operations/backup-restore.md). Not used by local development.
BACKUP_DIR=
BACKUP_KEEP=
BACKUP_MAX_AGE_HOURS=

# Tests only: real INN of an SME for the live K-12b contract check (never commit a value)
MSP_LIVE_INN=

# K-12a: directory with unpacked FNS EGRUL/EGRIP XML dumps (paid file integration).
# Empty = the EGRUL profile source reports `egrul_not_configured`.
EGRUL_DATA_DIR=
# Optional: run the ProfileSource contract tests against real dumps.
EGRUL_CONTRACT_KNOWN_INN=
EGRUL_CONTRACT_UNKNOWN_INN=
